# EmailJS — sign up free at https://www.emailjs.com/
# Copy this file to `.env` (already in .gitignore) and fill in real values.
# After editing .env, RESTART `npm run dev` — Vite only reads env vars at startup.

# Dashboard → Email Services → Add New Service (Gmail) → copy Service ID
VITE_EMAILJS_SERVICE_ID=service_9ypvqja

# Dashboard → Email Templates → Create template with variables:
#   {{from_name}}, {{from_email}}, {{message}}
# Then copy the Template ID
VITE_EMAILJS_TEMPLATE_ID=template_exdns6z

# Dashboard → Account → General → API Keys → copy Public Key
VITE_EMAILJS_PUBLIC_KEY=YDugMbsQNRDCgevfJ
